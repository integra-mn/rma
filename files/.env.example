# Integra RMA — environment configuration (example)
# Copy this file to `.env` and fill in real values. `.env` is blocked from
# web access by .htaccess and must never be committed to source control.

DB_HOST=your-db-host.example.com
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS="your_database_password"
DB_CHARSET=utf8mb4

# Optional: comma-separated list of trusted reverse-proxy IPs that may set
# X-Forwarded-For. Leave empty / omit when directly exposed.
# TRUSTED_PROXIES=10.0.0.1,10.0.0.2
